# ─────────────────────────────────────────────────────────────────────
# Eko AI Realtors — environment configuration
# Copy to .env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────

# App
APP_NAME=Eko AI Realtors
APP_ENV=development
APP_VERSION=0.0.1
DEBUG=true
LOG_LEVEL=INFO

# Database (Postgres on local network — never exposed)
DATABASE_URL=postgresql+asyncpg://eko:eko_local_pass@db:5432/eko_realestate
POSTGRES_USER=eko
POSTGRES_PASSWORD=eko_local_pass
POSTGRES_DB=eko_realestate

# Redis (queues + cache)
REDIS_URL=redis://redis:6379/0

# ─── LLM (Phase 1) ───────────────────────────────────────────────────
# Kimi 2.6 primary + MiniMax M2.7 fallback. Both speak the anthropic-messages
# protocol; we use the anthropic SDK with a custom base_url per provider.
# Fallback is INLINE per request (if primary times out, the same request retries
# against fallback before erroring out).
LLM_PRIMARY=kimi
LLM_FALLBACK=minimax
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS_DEFAULT=600

# Kimi For Coding API (kimi.com — NOT moonshot). Key prefix sk-kimi-...
# Get from https://kimi.com/code/docs/en/
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding

# MiniMax (api.minimax.io, anthropic-compat endpoint). Key prefix sk-cp-...
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────
# Get from https://developers.facebook.com/apps. While SIMULATED=true,
# whatsapp.send_text_message() LOGS the outbound payload instead of POSTing
# to Meta — required for dev without a registered Business app.
WHATSAPP_SIMULATED=true
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0

# ─── Email channel (Phase 3) ─────────────────────────────────────────
# Resend transactional API. When EMAIL_SIMULATED=true, outbound is LOGGED
# (no Resend account required for dev).
EMAIL_SIMULATED=true
RESEND_API_KEY=
RESEND_FROM=Eko AI Realtors <noreply@realtor-demo.ekoaiautomation.com>
RESEND_WEBHOOK_SECRET=

# ─── Calendar (Phase 5) ──────────────────────────────────────────────
# Cal.com integration. CALENDAR_SIMULATED=true logs all booking ops + returns
# fake slots so the dashboard works without a Cal.com account.
CALENDAR_SIMULATED=true
CALENDAR_PROVIDER=calcom
CALCOM_BASE_URL=https://api.cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ─── Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Eko AI Realtors

# ─── Discovery / lead search (Phase 12) ──────────────────────────────
# SIMULATED-first: true (default) = curated synthetic results, no keys needed.
# Set false + the keys below to search real sources. Colorado SOS is FREE (no
# key). Yelp/Google Maps/LinkedIn reuse the Eko AI sales-platform keys.
DISCOVERY_SIMULATED=true
YELP_API_KEY=
OUTSCRAPER_API_KEY=
SERPAPI_API_KEY=
FILE_IMPORT_MAX_MB=25
# Server-side enrichment worker: classifies imported discovery leads (intent +
# score) so it never depends on the browser. Backfills leads missed by the UI.
ENRICHMENT_ENABLED=true
ENRICHMENT_INTERVAL_SECONDS=120

# ─── Dashboard auth (Phase 11) ───────────────────────────────────────
# One office = one shared password. Leave AUTH_ENABLED=false for dev / a public
# demo (open dashboard). For a customer install set a password + enable it
# (the installer does this). AUTH_SECRET signs the session cookie (random; if
# blank it's derived from the password).
AUTH_ENABLED=false
DASHBOARD_PASSWORD=
AUTH_SECRET=
AUTH_TTL_HOURS=168

# ─── SMS (Phase 9 — Twilio) ──────────────────────────────────────────
# When SMS_SIMULATED=true (dev default), outbound is LOGGED and the inbound
# webhook accepts unsigned requests — no Twilio account needed. Production: fill
# the TWILIO_* values (see docs/setup-twilio.md) and set SMS_SIMULATED=false.
SMS_SIMULATED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exact public webhook URL configured in the Twilio console (for signature
# validation behind a proxy). Blank → reconstruct from forwarded headers.
TWILIO_WEBHOOK_URL=
# A2P 10DLC: once your number is registered under a Messaging Service, set its
# SID (MG...) — send_sms will send via the service (registered campaign) instead
# of the bare From number. Leave blank to send with TWILIO_PHONE_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
# Public URL for delivery status callbacks (e.g. .../api/v1/webhooks/sms/status).
# Set it to track delivered/undelivered + carrier error codes in the dashboard.
TWILIO_STATUS_CALLBACK_URL=

# ─── Listings / MLS (Phase 7) ────────────────────────────────────────
# When LISTINGS_SIMULATED=true (dev default), the listings service serves a
# curated Miami dataset and `scripts/sync_listings.py` upserts it — no MLS feed
# needed. Production: point at a RESO Web API (OData) feed — the USA MLS standard.
LISTINGS_SIMULATED=true
LISTINGS_PROVIDER=reso
RESO_BASE_URL=
RESO_ACCESS_TOKEN=
