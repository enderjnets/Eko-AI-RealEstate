# ─────────────────────────────────────────────────────────────────────
# Eko AI Realtors — environment configuration
# Copy to .env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────

# App
APP_NAME=Eko AI Realtors
APP_ENV=development
# APP_VERSION is deliberately absent: the application carries it in
# `backend/app/config.py`, which the release bumps. Setting it here means
# pinning a number by hand at every release and serving a stale one when you
# forget — which is what happened, for thirty releases.
DEBUG=true
LOG_LEVEL=INFO

# Database (Postgres on local network — never exposed)
DATABASE_URL=postgresql+asyncpg://eko:eko_local_pass@db:5432/eko_realestate
POSTGRES_USER=eko
POSTGRES_PASSWORD=eko_local_pass
POSTGRES_DB=eko_realestate

# Redis (queues + cache)
# The application connects as a role WITHOUT bypassrls, so Postgres row-level
# security actually applies to it. Migration 015 creates that role, and it runs
# inside the backend container — so APP_DB_PASSWORD must be set THERE too
# (docker-compose passes it) and must match the password inside DATABASE_URL_APP.
# Leave them at the defaults and the role that guards every tenant boundary has
# a password published in this repository.
DATABASE_URL_APP=postgresql+asyncpg://eko_app:CHANGE_ME@db:5432/eko_realestate
APP_DB_PASSWORD=CHANGE_ME
# Leave unset unless you also change it everywhere; the role name appears in
# several migrations.
# APP_DB_ROLE=eko_app
# Optional. A role WITH bypassrls, used for the handful of reads that happen
# before a tenant is known (login, the org list, destination routing) and for
# the platform router. Left empty the app uses DATABASE_URL for those, which on
# the default stack is a superuser — workable, but it means FORCE ROW LEVEL
# SECURITY is the only thing standing between a bug and every tenant's rows.
# DATABASE_URL_BYPASS=

REDIS_URL=redis://redis:6379/0

# ─── LLM (Phase 1) ───────────────────────────────────────────────────
# Kimi 2.6 primary + MiniMax M2.7 fallback. Both speak the anthropic-messages
# protocol; we use the anthropic SDK with a custom base_url per provider.
# Fallback is INLINE per request (if primary times out, the same request retries
# against fallback before erroring out).
LLM_PRIMARY=kimi
LLM_FALLBACK=minimax
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS_DEFAULT=600

# Kimi For Coding API (kimi.com — NOT moonshot). Key prefix sk-kimi-...
# Get from https://kimi.com/code/docs/en/
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding

# MiniMax (api.minimax.io, anthropic-compat endpoint). Key prefix sk-cp-...
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────
# Get from https://developers.facebook.com/apps. While SIMULATED=true,
# whatsapp.send_text_message() LOGS the outbound payload instead of POSTing
# to Meta — required for dev without a registered Business app.
# WhatsApp is OFF by default, and for a US brokerage that is the final answer:
# clients are reached by text, call and email. Turning it on is a decision with
# a Meta Business app behind it.
#
# Do NOT enable it with empty secrets. WHATSAPP_SIMULATED gates two unrelated
# things — outbound sending AND inbound HMAC verification — so switching
# simulation off without WHATSAPP_APP_SECRET does not "go live": every inbound
# webhook returns 403 until Meta disables the subscription. The backend refuses
# to start in that state rather than let you find out from a customer.
WHATSAPP_ENABLED=false
WHATSAPP_SIMULATED=true
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0

# ─── Email channel (Phase 3 — Resend) ────────────────────────────────
# Resend transactional API. When EMAIL_SIMULATED=true, outbound is LOGGED
# (no Resend account required for dev). For real delivery set EMAIL_SIMULATED=false
# + the RESEND_* values below.
#
# ISOLATION (non-negotiable): Realtors uses its OWN dedicated Resend subdomain
# (e.g. realtors.ekoaiautomation.com) + its OWN API key + webhook secret. NEVER
# reuse Eko AI Main's biz.ekoaiautomation.com / its key / its webhook — they are
# a separate product. See docs/setup-email.md for the subdomain + DNS setup.
EMAIL_SIMULATED=true
RESEND_API_KEY=
RESEND_FROM=Eko AI Realtors <noreply@realtors.ekoaiautomation.com>
RESEND_WEBHOOK_SECRET=

# ─── Calendar (Phase 5) ──────────────────────────────────────────────
# Cal.com integration. CALENDAR_SIMULATED=true logs all booking ops + returns
# fake slots so the dashboard works without a Cal.com account.
CALENDAR_SIMULATED=true
CALENDAR_PROVIDER=calcom
CALCOM_BASE_URL=https://api.cal.com
# The operator's calendar. An agency with its own Cal.com gets a `calendar`
# row in channel_routes instead: destination = their event type id,
# credential_ref = the variable holding their key. Without that every
# agency books onto this one, putting their leads' names, emails and phone
# numbers in front of whoever else uses it.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ─── Frontend ────────────────────────────────────────────────────────
# No NEXT_PUBLIC_API_URL here on purpose. `lib/api.ts` calls relative paths
# (`/api/...`) and `next.config.js` rewrites them to the backend over Docker's
# internal network, so the browser never needs to know where the API lives.
# Setting it to an absolute URL does nothing — but it reads as if the dashboard
# were pointed somewhere, which is exactly the wrong thing to believe while
# debugging a deploy.
NEXT_PUBLIC_APP_NAME=Eko AI Realtors

# The address the dashboard is meant to be reached at. Only used to tell a user
# where to go when they open it somewhere Google sign-in cannot work — an IP, or
# plain http on something that is not localhost. Leave blank for a single
# install reached only on localhost.
NEXT_PUBLIC_CANONICAL_URL=

# ─── Discovery / lead search (Phase 12) ──────────────────────────────
# SIMULATED-first: true (default) = curated synthetic results, no keys needed.
# Set false + the keys below to search real sources. Colorado SOS is FREE (no
# key). Yelp/Google Maps/LinkedIn reuse the Eko AI sales-platform keys.
DISCOVERY_SIMULATED=true
# ATTOM property/owner data → absentee / pre-foreclosure / high-equity categories.
ATTOM_API_KEY=
# Legacy business-search keys (Colorado SOS investor-LLC category needs no key):
YELP_API_KEY=
OUTSCRAPER_API_KEY=
SERPAPI_API_KEY=
FILE_IMPORT_MAX_MB=25

# ─── Content Studio (v0.52+) ─────────────────────────────────────────────
# Cap for uploaded clips, streamed to disk by the route itself.
CONTENT_UPLOAD_MAX_MB=95
# Mounted as the content-media volume in compose. Served only through the
# authenticated /api/v1/content/{id}/media route.
CONTENT_MEDIA_DIR=/data/media
# The generation loop. Off by default — turning it on is a per-install
# decision with an LLM bill; the cap bounds that bill from day one.
CONTENT_STUDIO_ENABLED=false
# Adónde manda el vídeo a quien lo ve. Vacío = sin llamada a la acción.
# Se rellena cuando denverhomestory.com esté vivo.
CONTENT_CTA_URL=

CONTENT_MAX_DRAFTS_PER_DAY=3
CONTENT_STUDIO_INTERVAL_SECONDS=3600
# Lane A render worker: uploaded clips -> 1080x1920 with the brokerage line
# burned into the final seconds. Separate switch from generation.
CONTENT_RENDER_ENABLED=false
CONTENT_RENDER_INTERVAL_SECONDS=900

# ─── Publishing through Buffer (v0.65) ───────────────────────────────────
# One integrator for YouTube, TikTok and Instagram. Simulated until a person
# turns it off, like every other adapter here.
BUFFER_SIMULATED=true
BUFFER_ACCESS_TOKEN=
# The organization the token must belong to. The publisher asks Buffer for
# this org's channels and refuses to post unless the ids below are exactly
# what came back.
BUFFER_ORG_ID=
BUFFER_CHANNEL_YOUTUBE=
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_INSTAGRAM=
CONTENT_PUBLISH_ENABLED=false
CONTENT_PUBLISH_INTERVAL_SECONDS=900
# Pieces per day, not posts.
CONTENT_PUBLISH_MAX_PER_DAY=4
# Where Buffer fetches the video from — a stable address, because Buffer
# downloads when the post goes out and rejects signed or expiring URLs.
# e.g. https://inmo-demo.ekoaiautomation.com
CONTENT_PUBLIC_BASE_URL=
CONTENT_PUBLISH_MAX_SECONDS=90
# WHOSE content rail this is: the brokerage line, the channels, the voice, the
# music and the domain on the end card all belong to one agency. 0 = the only
# organization on this install; with a second one present the writer, the
# render queue and the publisher all refuse until this names an agency.
CONTENT_ORG_ID=0

# ─── The render worker (v0.66) ───────────────────────────────────────────
# On: lane A queues the work for the machine with the media stack (which also
# adds subtitles) instead of rendering in this container. Off: the local
# renderer keeps working, which is the fallback when that machine is down.
RENDER_WORKER_ENABLED=false
# The worker's only credential. Empty means the queue answers 503 — closed,
# never open. Generate with: openssl rand -hex 32
RENDER_WORKER_TOKEN=
# Server-side enrichment worker: classifies imported discovery leads (intent +
# score) so it never depends on the browser. Backfills leads missed by the UI.
ENRICHMENT_ENABLED=true
ENRICHMENT_INTERVAL_SECONDS=120

# ─── Dashboard auth (Phase 11) ───────────────────────────────────────
# One office = one shared password. Leave AUTH_ENABLED=false for dev / a public
# demo (open dashboard). For a customer install set a password + enable it
# (the installer does this). AUTH_SECRET signs the session cookie (random; if
# blank it's derived from the password).
AUTH_ENABLED=false
DASHBOARD_PASSWORD=
# REQUIRED when AUTH_ENABLED=true. The session signing key, and the only source
# of it: it is deliberately NOT derived from DASHBOARD_PASSWORD any more. That
# password is the agency's — the office shares it with whoever answers the phone
# — and the token it would have signed carries both the organization and the
# platform-operator claim, so its holder could have minted either at will.
# scripts/install.sh generates one; `openssl rand -hex 32` otherwise.
AUTH_SECRET=
AUTH_TTL_HOURS=168

# ─── Google Sign In (Google Identity Services) ───────────────────────
# Coexists with DASHBOARD_PASSWORD (password login = admin of the default org,
# never a platform operator). When
# GOOGLE_CLIENT_ID is set, /login shows a "Sign in with Google" button. The
# backend validates the ID token and resolves the verified email to a role.
#
# Access list (who may log in, and as what role):
#   PLATFORM_ADMIN_EMAILS→ admins, and the only holders of platform access.
#   GOOGLE_ADMIN_EMAILS  → admins, PINNED in env — can't be removed/demoted from
#                          the UI (lockout-proof bootstrap). Comma-separated.
#   allowed_users table  → managed live by admins in Settings → Team (admin|member).
#   GOOGLE_ALLOWED_EMAILS→ members (back-compat static allow). Comma-separated.
#   GOOGLE_ALLOWED_DOMAIN→ members (any address @this-domain).
#   anything else        → DENIED (safe default — no accidental open access).
#
# The env lists win over the table on purpose: allowed_users.email is unique
# across every tenant and any agency's admin can add a row, so otherwise one
# agency could claim an operator's address and demote them on their next login.
# Being allowed in and belonging to an organization are resolved separately and
# BOTH must succeed — an address matching GOOGLE_ALLOWED_DOMAIN with no
# allowed_users row is refused, not placed in the default organization.
#
# Get GOOGLE_CLIENT_ID from console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID (Web application). Add your dashboard
# URL to "Authorized JavaScript origins" (e.g. https://inmo-demo.ekoaiautomation.com).
# See docs/setup-google-signin.md for the full walk-through.
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
# Who runs the SaaS, as opposed to who administers a client agency. Only these
# addresses can create agencies, map their phone numbers, or enter one to give
# support — and impersonation records which of them did it.
#
# Set this before onboarding a second agency. It is the ONLY source of platform
# access — the shared DASHBOARD_PASSWORD deliberately cannot grant it, because
# that password belongs to the agency: install.sh describes it as protecting
# /leads and the office shares it with whoever answers the phone.
# Public self-registration into the demo organization. The frontend renders a
# signup form from this; until now the flag was advertised and read nowhere,
# so it could not actually turn signup off.
REGISTRATION_ENABLED=true

PLATFORM_ADMIN_EMAILS=
# Frontend needs the SAME client ID — Next.js exposes only NEXT_PUBLIC_* vars.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Public capture form (Cloudflare Turnstile) ──────────────────────
# POST /api/v1/public/leads is the landing-page contact form: no session, open
# to the internet, and the only way a stranger who saw a video becomes a lead.
# It always has a honeypot, a per-IP limit (5 per 10 min) and a global ceiling
# (60 per 10 min) that bounds the damage even when the client IP is forged.
#
# Turnstile is the defence a determined script cannot outspend, and it is OFF
# while this is empty. Set it and verification becomes mandatory and
# fail-closed: if Cloudflare cannot be reached the submission is refused,
# because a captcha that passes everyone during an outage is not a captcha.
# Create the widget at dash.cloudflare.com → Turnstile; the secret key is the
# server-side half of the pair.
TURNSTILE_SECRET=
# The site key is the public half and belongs in the browser bundle. Leave it
# empty and the form renders without a captcha widget, which is consistent with
# an empty TURNSTILE_SECRET — set BOTH or NEITHER, or the widget collects a
# token nothing verifies (or the server demands one nothing produces).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Which agency /contact submits to: the `destination` of a channel_routes row
# with channel='web'. Leave EMPTY on a single-agency install — the endpoint
# falls back to the only agency there is. It becomes REQUIRED the moment a
# second organization exists: without it the submission is ambiguous and is
# refused with 404 rather than filed into whichever tenant came first.
# Baked into the browser bundle at build time, so changing it needs a rebuild.
NEXT_PUBLIC_CAPTURE_FORM_KEY=

# ─── Sign in with Apple ──────────────────────────────────────────────
# Coexists with Google + password. When APPLE_CLIENT_ID is set, /login shows a
# "Sign in with Apple" button. The backend verifies Apple's RS256 identity token
# (signature against appleid.apple.com/auth/keys, iss + aud + exp) and resolves
# the verified email against the SAME access list as Google (GOOGLE_ADMIN_EMAILS
# / allowed_users / GOOGLE_ALLOWED_EMAILS / GOOGLE_ALLOWED_DOMAIN above). Apple
# Private Relay addresses (@privaterelay.appleid.com) only log in if explicitly
# allow-listed.
#
# APPLE_CLIENT_ID is the SERVICES ID you create at developer.apple.com →
# Certificates, IDs & Profiles → Identifiers → Services IDs (e.g.
# com.ekoai.realtors.signin), with Sign in with Apple enabled and the dashboard
# domain + return URL registered in its Web Authentication Configuration. The
# web popup flow returns the id_token directly, so no .p8 key / client secret is
# needed for login. See docs/setup-apple-signin.md for the full walk-through.
APPLE_CLIENT_ID=
# Frontend needs the SAME Services ID + a registered return URL. In popup mode
# the return URL's ORIGIN must equal the site origin (e.g.
# https://inmo-demo.ekoaiautomation.com/login). Next.js exposes only NEXT_PUBLIC_*.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# ─── SMS (Phase 9 — Twilio) ──────────────────────────────────────────
# Exigir email en el formulario publico. En true mientras el SMS este caido
# (A2P 10DLC sin registrar): un lead que solo deja telefono no es alcanzable
# por ningun canal automatico. Volver a false cuando el SMS entregue.
CAPTURE_REQUIRE_EMAIL=true

# Embudo interino: con true, los carriles automaticos (chat y voz) NO ofrecen
# ni toman horas de cita — prometen una llamada del agente. El panel manual no
# se toca. Volver a false cuando el calendario del agente este conectado a
# Cal.com y PROBADO (una hora ocupada suya deja de ofrecerse).
BOOKING_OFFERS_PAUSED=false

# When SMS_SIMULATED=true (dev default), outbound is LOGGED and the inbound
# webhook accepts unsigned requests — no Twilio account needed. Production: fill
# the TWILIO_* values (see docs/setup-twilio.md) and set SMS_SIMULATED=false.
SMS_SIMULATED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio API Key, para ENVIAR. Twilio lo recomienda para toda aplicacion:
# revocar una clave corta el envio sin tocar nada mas. El AUTH_TOKEN de
# arriba se queda SOLO para validar la firma de los webhooks entrantes, que
# es lo unico que Twilio no deja hacer con una API Key.
# El SID es el de la propia clave (SK...), NO el Account SID.
# Los dos vacios = se envia con (Account SID, Auth Token), como siempre.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Exact public webhook URL configured in the Twilio console (for signature
# validation behind a proxy). Blank → reconstruct from forwarded headers.
TWILIO_WEBHOOK_URL=
# A2P 10DLC: once your number is registered under a Messaging Service, set its
# SID (MG...) — send_sms will send via the service (registered campaign) instead
# of the bare From number. Leave blank to send with TWILIO_PHONE_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
# Public URL for delivery status callbacks (e.g. .../api/v1/webhooks/sms/status).
# Set it to track delivered/undelivered + carrier error codes in the dashboard.
TWILIO_STATUS_CALLBACK_URL=

# ─── Listings / MLS (Phase 7) ────────────────────────────────────────
# When LISTINGS_SIMULATED=true (dev default), the listings service serves a
# curated Miami dataset and `scripts/sync_listings.py` upserts it — no MLS feed
# needed. Production: point at a RESO Web API (OData) feed — the USA MLS standard.
LISTINGS_SIMULATED=true
LISTINGS_PROVIDER=reso
RESO_BASE_URL=
RESO_ACCESS_TOKEN=
# ─── MLS Grid / REcolorado (replication) ─────────────────────────────
# REcolorado ships its RESO Web API via MLS Grid. We replicate incrementally
# (by ModificationTimestamp) into `properties`. VERIFY the *_VERIFY values against
# the MLS Grid data dictionary once the feed is provisioned. The sync WORKER is OFF
# by default so it never spins on errors before the token exists — flip it on (with
# RESO_BASE_URL + RESO_ACCESS_TOKEN set) to replicate on an interval.
RESO_ORIGINATING_SYSTEM=recolorado   # OData OriginatingSystemName — VERIFY exact value/casing
RESO_PAGE_SIZE=1000                   # $top per page; the code default. 1000 is the
                                      # cap when $expand is used (5000 without)
RESO_MAX_PAGES=50                     # pagination safety cap (crash-safe: cursor advances per page)
LISTINGS_SYNC_ENABLED=false          # in-process replication worker
LISTINGS_SYNC_INTERVAL_SECONDS=900   # 15 min — VERIFY MLS Grid recommended cadence

# ─── Everything else the app reads ───────────────────────────────────
# All of these have working defaults in `backend/app/config.py`; they are
# listed so an operator can find the name without reading the source. An audit
# found eighteen of them undocumented, including the whole voice stack — an
# operator turning on phone calls had no way to know what the keys were called.

# The role that bypasses row-level security, for the background workers that
# sweep every organization. Defaults to DATABASE_URL (the owner).
DATABASE_URL_BYPASS=

# Browser origins allowed to call the API. The dashboard proxies same-origin,
# so this only matters if something else talks to the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3004

# Office timezone a brand-new agency starts on, until they set their own.
DEFAULT_TIMEZONE=America/Denver

# Retry sweep for replies a provider refused the first time.
DELIVERY_RETRY_ENABLED=true
DELIVERY_RETRY_INTERVAL_SECONDS=120

# Visit reminders and post-visit follow-ups.
FOLLOWUPS_ENABLED=true
FOLLOWUPS_INTERVAL_SECONDS=300

# Voice (VAPI). VOICE_SIMULATED=true answers without calling the provider.
VOICE_SIMULATED=true
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_BASE_URL=https://api.vapi.ai

# Third LLM fallback, off by default: a local Ollama.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://172.20.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120.0

# Watchdog over that fallback. `OLLAMA_ENABLED=true` is a statement of intent;
# this is what turns it into a measurement, and what tells a human when the
# measurement changes. The check is cheap and frequent (a local /api/tags
# listing, no model load); the alert is rare by construction — it fires on a
# CHANGE of state, never on the state, and is capped at 3 per UTC day because it
# shares the email provider's quota with replies to real customers.
LLM_MONITOR_INTERVAL_SECONDS=300
# Sender for operator alerts. NOT a tenant identity: the monitor runs in a
# background worker with no organization, and an alert to us is not a reply to
# anybody's lead. Must be on a domain verified with Resend. Empty means alerts
# are written to the log and never sent — which is said out loud at the time,
# because a monitor that can reach nobody is the exact thing this feature exists
# to stop. Recipients are PLATFORM_ADMIN_EMAILS.
OPS_ALERT_FROM=

# Politeness pause between REcolorado pages.
RESO_MIN_REQUEST_INTERVAL_SECONDS=0.5

# ---------------------------------------------------------------------------
# Public landing (/) — the marketing page a stranger arrives at from an ad or
# a video. Read at BUILD time like every NEXT_PUBLIC_*, so changing one needs
# a frontend rebuild, not a restart.
#
# Every value here is a factual claim about a licensed brokerage. Anything left
# empty makes the section that needs it disappear, which is deliberate: an
# invented phone number, tenure figure or client quote on a real-estate advert
# is false advertising, not a placeholder. Leave it blank until it is real.
# ---------------------------------------------------------------------------

# Shown in the header and the footer.
NEXT_PUBLIC_LANDING_ADVISORS=
NEXT_PUBLIC_LANDING_BROKERAGE=

# Colorado advertising rules want the brokerage identifiable. Confirm the exact
# office address with the managing broker before filling this in.
NEXT_PUBLIC_LANDING_ADDRESS=

# The "Reach us" section renders one tile per number/mailbox that is set, and
# disappears entirely when none are. Write them as humans read them; the tel:
# and sms: links are normalised for you.
NEXT_PUBLIC_LANDING_PHONE=
NEXT_PUBLIC_LANDING_SMS=
NEXT_PUBLIC_LANDING_EMAIL=

# The stat strip is all-or-nothing — one lonely number reads as an omission.
NEXT_PUBLIC_LANDING_YEARS=
NEXT_PUBLIC_LANDING_MARKETS=

# Hero portrait. Without it the hero collapses to a single column on purpose.
NEXT_PUBLIC_LANDING_PORTRAIT=

# Cal.com (or equivalent) link for "Book a consult". Unset = the button scrolls
# to the form on the page, which is the path that works today.
NEXT_PUBLIC_LANDING_BOOKING_URL=

# Real, cleared client testimonials only, as a JSON array. Unset = no section.
# [{"quote":"…","attribution":"Seller · Cherry Creek North"}]
NEXT_PUBLIC_LANDING_TESTIMONIALS=

# Which hostname serves the public brand site and which serves the operator
# panel. One Next app serves both, so without these every hostname answers
# both halves: the brand domain would serve the internal login at /leads and
# the same marketing page would be indexed under every name that reaches it.
# LEAVE BOTH EMPTY until denverhomestory.com actually resolves through
# Cloudflare. Empty is inert: no redirects, no canonical tags, today's
# behaviour exactly. Filled in before DNS propagates, the panel redirects to a
# hostname that answers nothing and the canonical points at a dead domain.
# Example once live:
#   NEXT_PUBLIC_BRAND_URL=https://www.denverhomestory.com
#   NEXT_PUBLIC_PANEL_URL=https://realtors.ekoaiautomation.com
NEXT_PUBLIC_BRAND_URL=
NEXT_PUBLIC_PANEL_URL=
