# ─────────────────────────────────────────────────────────────────────
# Eko AI Inmobiliario — environment configuration
# Copy to .env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────

# App
APP_NAME=Eko AI Inmobiliario
APP_ENV=development
APP_VERSION=0.0.1
DEBUG=true
LOG_LEVEL=INFO

# Database (Postgres on local network — never exposed)
DATABASE_URL=postgresql+asyncpg://eko:eko_local_pass@db:5432/eko_realestate
POSTGRES_USER=eko
POSTGRES_PASSWORD=eko_local_pass
POSTGRES_DB=eko_realestate

# Redis (queues + cache)
REDIS_URL=redis://redis:6379/0

# Ollama (local LLM — no cloud calls)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# WhatsApp Business Cloud API (Meta)
# Get from https://developers.facebook.com/apps
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Calendar (Cal.com is the default; switch to Google by changing CALENDAR_PROVIDER)
CALENDAR_PROVIDER=calcom
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Eko AI Inmobiliario

# Real-estate portals (optional V2 scrapers)
IDEALISTA_ENABLED=false
FOTOCASA_ENABLED=false
